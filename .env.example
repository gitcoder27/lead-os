JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-api-token
# Required in production: stable app secret used to encrypt stored Jira API tokens.
# Generate with: openssl rand -base64 32
JIRA_TOKEN_ENCRYPTION_KEY=
JIRA_PROJECT_KEY=PROJ
# Optional: custom Jira sync query. Use {PROJECT_KEY} if you want it to track JIRA_PROJECT_KEY automatically.
# JIRA_SYNC_JQL=project = {PROJECT_KEY} AND statusCategory != Done
JIRA_SYNC_JQL=project = AM AND issuetype = "AS: Test Defect" AND "aspen scrum team[dropdown]" = "ASPEN+ Modernization Team 2" AND assignee = 63cf64f4f6e1b54316164a0d ORDER BY "cf[11521]" ASC, "cf[10128]" ASC, status ASC, updated DESC, Rank ASC
# Optional: Jira custom field used to surface ASPEN Severity in the triage panel.
# JIRA_ASPEN_SEVERITY_FIELD=customfield_10129
PORT=3002
# Optional: frontend dev port for Vite in local-only overrides such as .env.local.
# VITE_PORT=5173
# Optional: dedicated frontend API proxy port for local dev.
# VITE_API_PORT=3002
# Optional: override the frontend API proxy target with a full URL.
# VITE_API_PROXY_TARGET=http://127.0.0.1:3002
# Optional: only set this to allow `npm run dev` to proxy to a non-local API target.
# ALLOW_REMOTE_DEV_PROXY=false
# Optional: which reverse proxies to trust for the client IP (Express "trust proxy"). Unset = off:
# X-Forwarded-For is ignored and the login throttle keys on the socket address.
# Behind nginx or cloudflared on the same host (production) set: loopback
# Accepts a hop count (1-10), loopback / linklocal / uniquelocal, or a comma-separated list of proxy IPs/CIDRs.
# `true` is rejected on purpose (clients could spoof X-Forwarded-For). See docs/23 "Client IP And TRUST_PROXY".
# TRUST_PROXY=loopback
# Optional: where the public landing page's "Request access" button points, read at client build time.
# An https:// URL (a form) or a mailto: link. Unset hides the button; "Sign in" always shows.
# VITE_LEADOS_ACCESS_URL=mailto:you@example.com?subject=LeadOS%20access
